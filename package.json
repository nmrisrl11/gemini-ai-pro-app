{
	"name": "gemini-ai-pro-app",
	"version": "1.0.0",
	"private": true,
	"description": "An open-source browser extension and companion portal for Google One 5TB Google AI Pro promotional offer management and Google Play checkout price verification.",
	"homepage": "https://github.com/nmrisrl11/gemini-ai-pro-app#readme",
	"bugs": {
		"url": "https://github.com/nmrisrl11/gemini-ai-pro-app/issues"
	},
	"license": "MIT",
	"author": "Nomer Israel <https://github.com/nmrisrl11>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nmrisrl11/gemini-ai-pro-app.git"
	},
	"type": "module",
	"scripts": {
		"dev": "vite",
		"dev:ext": "vite -c vite.ext.config.ts",
		"build:ext": "vite build -c vite.ext.config.ts",
		"pack:ext": "npm run build:ext && node scripts/pack-extension.js",
		"build": "oxlint src --deny-warnings && tsc -b && vite build",
		"lint": "oxlint src",
		"preview": "vite preview",
		"format": "oxfmt . --write --ignore-path=.oxfmtignore",
		"format:check": "oxfmt . --check --ignore-path=.oxfmtignore"
	},
	"dependencies": {
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@fontsource/caveat": "^5.3.0",
		"@tailwindcss/vite": "^4.3.4",
		"@vercel/analytics": "^2.0.1",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.5.2",
		"lucide-react": "^1.69.0",
		"radix-ui": "^1.8.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"shadcn": "^4.23.0",
		"tailwindcss": "^4.3.4",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@types/chrome": "^0.3.4",
		"@types/node": "^24.19.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"oxfmt": "^0.76.0",
		"oxlint": "^1.91.0",
		"typescript": "~7.0.2",
		"vite": "^8.3.6",
		"vite-plugin-web-extension": "^4.5.1"
	},
	"overrides": {
		"minimatch": "^11.0.5"
	}
}
